{
  "name": "@sap-ai-sdk/sample-code",
  "version": "2.14.0",
  "private": true,
  "bin": {
    "sap-ai-sdk-sample-server": "./dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "node src/server.ts",
    "local": "node --env-file-if-exists=.env src/server.ts",
    "agent-tutorial": "node --env-file-if-exists=.env src/tutorials/travel-itinerary-agent.ts",
    "realtime-demo": "node --env-file-if-exists=.env src/openai-realtime.ts",
    "compile": "tsc",
    "dev": "tsc -w",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt ."
  },
  "dependencies": {
    "@langchain/classic": "1.0.52",
    "@langchain/core": "catalog:",
    "@langchain/langgraph": "catalog:",
    "@langchain/mcp-adapters": "2.0.0",
    "@langchain/textsplitters": "1.0.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sap-cloud-sdk/resilience": "catalog:",
    "@sap-cloud-sdk/util": "catalog:",
    "@types/express": "5.0.6",
    "express": "5.2.1",
    "langchain": "catalog:",
    "openai": "7.28.0",
    "ws": "8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-github": "2025.4.8",
    "@sap-ai-sdk/ai-api": "workspace:^",
    "@sap-ai-sdk/context-registry": "workspace:^",
    "@sap-ai-sdk/document-grounding": "workspace:^",
    "@sap-ai-sdk/foundation-models": "workspace:^",
    "@sap-ai-sdk/langchain": "workspace:^",
    "@sap-ai-sdk/llm-batch": "workspace:^",
    "@sap-ai-sdk/openai": "workspace:^",
    "@sap-ai-sdk/orchestration": "workspace:^",
    "@sap-ai-sdk/prompt-registry": "workspace:^",
    "@sap-ai-sdk/rpt": "workspace:^",
    "@sap-ai-sdk/tabular-orchestration": "workspace:^",
    "@types/ws": "8.18.2",
    "@upstash/context7-mcp": "4.1.1",
    "hyparquet-writer": "0.16.10"
  },
  "peerDependencies": {
    "@sap-ai-sdk/ai-api": "*",
    "@sap-ai-sdk/context-registry": "*",
    "@sap-ai-sdk/document-grounding": "*",
    "@sap-ai-sdk/foundation-models": "*",
    "@sap-ai-sdk/langchain": "*",
    "@sap-ai-sdk/llm-batch": "*",
    "@sap-ai-sdk/openai": "*",
    "@sap-ai-sdk/orchestration": "*",
    "@sap-ai-sdk/prompt-registry": "*",
    "@sap-ai-sdk/rpt": "*",
    "@sap-ai-sdk/tabular-orchestration": "*"
  }
}
