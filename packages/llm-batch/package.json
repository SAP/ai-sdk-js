{
  "name": "@sap-ai-sdk/llm-batch",
  "version": "2.15.0",
  "description": "",
  "keywords": [
    "ai-api",
    "llm-batch",
    "sap-ai-sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/llm-batch"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "compile": "tsc",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "generate": "openapi-generator --generateESM --clearOutputDir -i ./src/spec/batch-service.yaml -o ./src/client",
    "postgenerate": "pnpm update-imports && pnpm postgenerate-batch && pnpm lint:fix",
    "postgenerate-batch": "node ../../scripts/postgenerate-llm-batch.ts ./src/client/batch-service",
    "update-imports": "node ../../scripts/update-imports.ts ./src/client/batch-service"
  },
  "dependencies": {
    "@sap-ai-sdk/core": "workspace:^"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
