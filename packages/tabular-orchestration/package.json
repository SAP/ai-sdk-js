{
  "name": "@sap-ai-sdk/tabular-orchestration",
  "version": "2.16.0",
  "description": "This package provides a client for predictions with Tabular Foundation Models through the SAP AI Core Tabular AI Orchestration service.",
  "keywords": [
    "rpt",
    "sap-ai-sdk",
    "tabular-orchestration"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/tabular-orchestration"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "compile": "tsc",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "generate": "openapi-generator --generateESM --clearOutputDir -i ./src/spec/tabular-orchestration.yaml -o ./src/client -s ./src/spec/options-per-service.json",
    "postgenerate": "pnpm update-imports && pnpm make-experimental && pnpm lint:fix",
    "update-imports": "node ../../scripts/update-imports.ts ./src/client/tabular-orchestration",
    "make-experimental": "node ../../scripts/postgenerate-tabular-orchestration.ts ./src/client/tabular-orchestration/predict-api.ts"
  },
  "dependencies": {
    "@sap-ai-sdk/ai-api": "workspace:^",
    "@sap-ai-sdk/core": "workspace:^",
    "@sap-cloud-sdk/connectivity": "catalog:",
    "@sap-cloud-sdk/http-client": "catalog:"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
