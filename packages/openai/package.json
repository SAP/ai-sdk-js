{
  "name": "@sap-ai-sdk/openai",
  "version": "2.15.0",
  "publishConfig": {
    "tag": "beta",
    "access": "public"
  },
  "description": "SAP AI SDK integration with the official OpenAI npm package for Azure OpenAI on SAP AI Core",
  "license": "Apache-2.0",
  "keywords": [
    "sap-ai-sdk",
    "openai",
    "azure-openai",
    "foundation-models"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/openai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    },
    "./realtime/internal.js": {
      "types": "./dist/realtime/internal.d.ts",
      "default": "./dist/realtime/internal.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "compile": "tsc",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt ."
  },
  "dependencies": {
    "@sap-ai-sdk/ai-api": "workspace:^",
    "@sap-ai-sdk/core": "workspace:^",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/util": "^4.9.1"
  },
  "peerDependencies": {
    "openai": "^6.49.0 || ^7.0.0",
    "ws": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "openai": "7.4.0",
    "ws": "8.21.3",
    "vitest": "4.1.11"
  }
}
