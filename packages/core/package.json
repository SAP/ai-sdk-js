{
  "name": "@sap-ai-sdk/core",
  "version": "2.16.0",
  "description": "",
  "keywords": [
    "ai-core",
    "sap-ai-sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAP/ai-sdk-js",
    "directory": "packages/core"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal.js": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "compile": "tsc",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt ."
  },
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "catalog:",
    "@sap-cloud-sdk/http-client": "catalog:",
    "@sap-cloud-sdk/openapi": "catalog:",
    "@sap-cloud-sdk/util": "catalog:"
  },
  "devDependencies": {
    "vitest": "5.0.2"
  }
}
