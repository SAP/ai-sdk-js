{
  "name": "merge-and-write-changelogs",
  "version": "1.0.0",
  "description": "Merges all changelogs produced by changesets into one changelog and writes it to a merged CHANGELOG file",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "postcompile": "rolldown -c rolldown.config.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@manypkg/get-packages": "^3.1.0"
  },
  "devDependencies": {
    "@sap-ai-sdk/test-util-build-internal": "workspace:^",
    "@typescript/native": "npm:typescript@7.0.2",
    "rolldown": "1.2.5"
  }
}
