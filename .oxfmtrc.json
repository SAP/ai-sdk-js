{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 80,
  "sortPackageJson": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "sap-external",
        "modifiers": ["value"],
        "elementNamePattern": ["@sap-ai-sdk/**", "@sap-cloud-sdk/**"]
      },
      {
        "groupName": "type-sap-external",
        "modifiers": ["type"],
        "elementNamePattern": ["@sap-ai-sdk/**", "@sap-cloud-sdk/**"]
      }
    ],
    "groups": [
      "builtin",
      "sap-external",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown",
      "type-sap-external",
      "type"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "dist-cjs/",
    "coverage/",
    "pnpm-lock.yaml",
    "packages/prompt-registry/src/zod"
  ],
  "overrides": [
    {
      "files": ["jest.config.mjs"],
      "options": {
        "trailingComma": "all"
      }
    }
  ]
}
