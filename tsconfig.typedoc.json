{
  "extends": "./tsconfig.base.json",
  "include": [
    "./packages/ai-api/**/*",
    "./packages/core/**/*",
    "./packages/context-registry/**/*",
    "./packages/document-grounding/**/*",
    "./packages/foundation-models/**/*",
    "./packages/langchain/**/*",
    "./packages/openai/**/*",
    "./packages/orchestration/**/*",
    "./packages/prompt-registry/**/*",
    "./packages/rpt/**/*",
    "./packages/tabular-orchestration/**/*"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/dist/**",
    "**/dist-cjs/**",
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "./packages/ai-api"
    },
    {
      "path": "./packages/core"
    },
    {
      "path": "./packages/context-registry"
    },
    {
      "path": "./packages/document-grounding"
    },
    {
      "path": "./packages/foundation-models"
    },
    {
      "path": "./packages/langchain"
    },
    {
      "path": "./packages/openai"
    },
    {
      "path": "./packages/orchestration"
    },
    {
      "path": "./packages/prompt-registry"
    },
    {
      "path": "./packages/rpt"
    },
    {
      "path": "./packages/tabular-orchestration"
    }
  ],
  "typedocOptions": {
    "out": "knowledge-base/api-reference",
    "entryPoints": [
      "packages/ai-api/src/index.ts",
      "packages/core/src/index.ts",
      "packages/context-registry/src/index.ts",
      "packages/document-grounding/src/index.ts",
      "packages/foundation-models/src/index.ts",
      "packages/langchain/src/index.ts",
      "packages/langchain/src/orchestration/prompt-caching-middleware/index.ts",
      "packages/openai/src/index.ts",
      "packages/openai/src/realtime/index.ts",
      "packages/orchestration/src/index.ts",
      "packages/prompt-registry/src/index.ts",
      "packages/rpt/src/index.ts",
      "packages/tabular-orchestration/src/index.ts"
    ],
    "name": "SAP AI SDK for JavaScript",
    "readme": "DOCUMENTATION.md",
    "theme": "default",
    "includeVersion": true,
    "hideGenerator": true,
    "excludePrivate": true,
    "treatWarningsAsErrors": false,
    "validation": {
      "invalidLink": true
    },
    "navigation": {
      "includeFolders": false
    }
  }
}
